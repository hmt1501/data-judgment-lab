{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "data-judgment-lab-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "data-judgment-lab",
      "migrations_dir": "migrations",
      "database_id": "166db355-9231-447e-abac-388b46b27af5"
    }
  ],
  "vars": {
    // phân cách bằng dấu phẩy; ":*" ở cuối = mọi cổng
    "ALLOWED_ORIGINS": "https://hmt1501.github.io,http://localhost:*,http://127.0.0.1:*",
    // AI chạy bằng key Groq của người dùng (không có key chung). Bài AI lưu công khai nên vẫn giới hạn số bài mỗi IP mỗi ngày
    "DAILY_LIMIT_PER_IP": "30",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    // Hỏi nhanh (bong bóng chat): model nhỏ, nhanh
    "CHAT_MODEL": "openai/gpt-oss-20b",
    // đồng bộ tiến độ: số mã đồng bộ được tạo mỗi ngày (toàn hệ thống / mỗi IP)
    "SYNC_CREATE_DAILY": "500",
    "SYNC_CREATE_PER_IP": "10"
  }
}
